{
  "branches": [
    "release/*"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular",
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES",
            "BREAKING"
          ]
        },
        "writerOpts": {
          "commitsSort": [
            "subject",
            "scope"
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false,
        "tarballDir": "packages/ui/dist",
        "pkgRoot": "packages/ui"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": true,
        "assets": [
          {
            "path": "packages/ui/dist/*.tgz",
            "label": "Distribution"
          }
        ]
      }
    ],
    [
      "semantic-release-github-pullrequest",
      {
        "baseRef": "main",
        "assets": [
          "CHANGELOG.md",
          "package.json"
        ]
      }
    ]
  ]
}
