{
  "name": "design-system",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo run build",
    "build:ui": "pnpm --filter @design-system/ui build",
    "dev": "dotenv -- turbo run dev",
    "shadcn:add": "cd packages/ui && pnpm dlx shadcn@latest add",
    "pretest": "pnpm build:ui",
    "test": "jest --verbose",
    "test:coverage": "pnpm test --coverage",
    "test:watch": "pnpm test --watch",
    "test:staged": "pnpm test --onlyChanged --passWithNoTests",
    "lint": "turbo run lint",
    "clean": "bash ./scripts/clean.sh node_modules dist .turbo",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,cjs,css,mjs,md,mdx,json,html}\"",
    "check-types": "turbo run check-types",
    "prepare": "pnpm exec husky"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@storybook/addon-a11y": "^9.1.2",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-links": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@turbo/gen": "^2.5.6",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.0",
    "conventional-changelog": "^7.1.1",
    "dotenv-cli": "^9.0.0",
    "eslint": "^9.33.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "storybook": "^9.1.2",
    "storybook-addon-tag-badges": "^2.0.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typescript": "5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-svgr": "^4.3.0"
  },
  "packageManager": "pnpm@10.14.0",
  "version": "2.5.11"
}
