{
  "name": "@design-system/ui",
  "version": "0.0.0",
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./cn": {
      "types": "./src/lib/utils.tsx",
      "import": "./dist/lib/utils.mjs",
      "require": "./dist/lib/utils.js"
    },
    "./colors.css": "./dist/colors.css",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "postversion": "cp -r ../../README.md .. && cp -r ../../CHANGELOG.md .. && npm pkg delete devDependencies scripts",
    "build:assets": "cp ../../config/tailwind-config/colors.css ./dist/colors.css && rm -rf ./dist/themes && cp -R ./src/themes ./dist/themes",
    "build:tailwind": "tailwindcss -i ./src/styles.css -o ./dist/styles.css",
    "build": "tsup && pnpm build:assets && pnpm build:tailwind",
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "dev": "concurrently \"tsup --watch\" \"pnpm build:tailwind --watch\"",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@design-system/eslint-config": "workspace:*",
    "@design-system/typescript-config": "workspace:*"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1"
  }
}
